# systemd unit for the PR/PO scraper (po_scraper module — feeds pr_entries/po_entries for the
# DD Tracker module).
#
# Shares the SmartPAL login session with pir_scraper (same auth.json) — mirrors the naming/paths
# of the other scrapers already running on production.
#
# Install:
#   sudo cp deploy/pi_tracker_po_scrape.service /etc/systemd/system/
#   sudo cp deploy/pi_tracker_po_scrape.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pi_tracker_po_scrape.timer

[Unit]
Description=PI Follow-up Tracker - Purchase Requisition/Order scrape (SmartPAL)
After=network.target

[Service]
Type=oneshot
User=Deployer
Group=www-data
WorkingDirectory=/opt/pi_tracker/current/backend
EnvironmentFile=/opt/pi_tracker/current/backend/.env
ExecStart=/opt/pi_tracker/current/backend/venv/bin/python -m app.services.po_scraper.scraper
