# Already installed on production as of 2026-10 — documented here for reference/reproducibility
# (was previously only on the VM's /etc/systemd/system, not version-controlled). Runs the PIR
# entries sweep AND rejection-scraping (pir_rejections) in one pass — see
# app/services/pir_scraper/scraper.py.
#
# Install:
#   sudo cp deploy/pi_tracker_pir_scrape.service /etc/systemd/system/
#   sudo cp deploy/pi_tracker_pir_scrape.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pi_tracker_pir_scrape.timer

[Unit]
Description=PI Follow-up Tracker - PIR scrape (SmartPAL)
After=network.target

[Service]
Type=oneshot
User=Deployer
Group=www-data
WorkingDirectory=/opt/pi_tracker/PI-TRACKER/backend
EnvironmentFile=/opt/pi_tracker/PI-TRACKER/backend/.env
ExecStart=/opt/pi_tracker/PI-TRACKER/backend/venv/bin/python -m app.services.pir_scraper.scraper
