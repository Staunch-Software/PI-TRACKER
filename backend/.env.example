# Copy this file to .env and fill in real values. Never commit .env.
PORT=8080
ENVIRONMENT=development

# Local dev: postgresql+psycopg2://gokul:PASSWORD@localhost:5432/pi_tracker
# Azure: value of the Flexible Server connection string (App Service Application Setting)
DATABASE_URL=postgresql+psycopg2://gokul:CHANGE_ME@localhost:5432/pi_tracker

SESSION_SECRET=change-this-to-a-long-random-string

CORS_ALLOWED_ORIGIN=http://localhost:5183

# Azure Blob Storage (local dev can point this at Azurite: UseDevelopmentStorage=true)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=invoice-attachments
